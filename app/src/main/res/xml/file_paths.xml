<?xml version="1.0" encoding="utf-8"?>
<!--
  Only these two directories are shareable. The database itself is never exposed — a backup
  is shared instead, and it is encrypted under the owner's passphrase (FR-D1).
-->
<paths>
    <cache-path name="exports" path="exports/" />
    <files-path name="backups" path="backups/" />
</paths>
